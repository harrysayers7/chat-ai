# ===========================================
# STAGING ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.staging and fill in your values
# This file is used for staging deployments

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=staging
NEXT_PUBLIC_BASE_URL=http://testchat.sayers.app
BETTER_AUTH_URL=http://testchat.sayers.app
NO_HTTPS=1

# ===========================================
# AUTHENTICATION (REQUIRED)
# ===========================================
# Generate a secure secret: https://auth-secret-gen.vercel.app/
BETTER_AUTH_SECRET=your-staging-auth-secret-here

# ===========================================
# DATABASE (REQUIRED)
# ===========================================
# PostgreSQL connection string for staging
POSTGRES_URL=postgresql://username:password@localhost:5432/better_chatbot_staging

# ===========================================
# LLM PROVIDERS (At least one required)
# ===========================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# XAI (Grok)
XAI_API_KEY=your-xai-api-key-here

# OpenRouter (for multiple models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Ollama (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# FEATURE FLAGS
# ===========================================
DISABLE_SIGN_UP=0
DISABLE_EMAIL_SIGN_IN=0
FILE_BASED_MCP_CONFIG=false

# ===========================================
# OAUTH PROVIDERS (Optional)
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ===========================================
# MCP SERVERS (Optional)
# ===========================================
# Enable MCP server configuration
MCP_SERVER_ENABLED=true

# ===========================================
# MONITORING & LOGGING (Optional)
# ===========================================
# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn-here

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ===========================================
# EXTERNAL SERVICES (Optional)
# ===========================================
# Exa API for web search
EXA_API_KEY=your-exa-api-key-here

# Redis for caching (if using)
REDIS_URL=redis://localhost:6379

# ===========================================
# STAGING SPECIFIC SETTINGS
# ===========================================
# Allow less secure settings for staging
ALLOW_INSECURE_CONNECTIONS=1
SKIP_SSL_VERIFICATION=1

# Staging database settings
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=30000

# ===========================================
# DEPLOYMENT SETTINGS
# ===========================================
# Server configuration
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# Health check endpoint
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/api/health

