# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.production and fill in your values
# This file is used for production deployments

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://chat.sayers.app
BETTER_AUTH_URL=https://chat.sayers.app
NO_HTTPS=0

# ===========================================
# AUTHENTICATION (REQUIRED)
# ===========================================
# Generate a secure secret: https://auth-secret-gen.vercel.app/
BETTER_AUTH_SECRET=your-production-auth-secret-here

# ===========================================
# DATABASE (REQUIRED)
# ===========================================
# PostgreSQL connection string for production
POSTGRES_URL=postgresql://username:password@localhost:5432/better_chatbot_production

# ===========================================
# LLM PROVIDERS (At least one required)
# ===========================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# XAI (Grok)
XAI_API_KEY=your-xai-api-key-here

# OpenRouter (for multiple models)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Ollama (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# FEATURE FLAGS
# ===========================================
DISABLE_SIGN_UP=0
DISABLE_EMAIL_SIGN_IN=0
FILE_BASED_MCP_CONFIG=false

# ===========================================
# OAUTH PROVIDERS (Optional)
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ===========================================
# MCP SERVERS (Optional)
# ===========================================
# Enable MCP server configuration
MCP_SERVER_ENABLED=true

# ===========================================
# MONITORING & LOGGING (Optional)
# ===========================================
# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn-here

# Log level (debug, info, warn, error)
LOG_LEVEL=warn

# ===========================================
# EXTERNAL SERVICES (Optional)
# ===========================================
# Exa API for web search
EXA_API_KEY=your-exa-api-key-here

# Redis for caching (if using)
REDIS_URL=redis://localhost:6379

# ===========================================
# PRODUCTION SPECIFIC SETTINGS
# ===========================================
# Security settings for production
ALLOW_INSECURE_CONNECTIONS=0
SKIP_SSL_VERIFICATION=0

# Production database settings
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=60000

# ===========================================
# DEPLOYMENT SETTINGS
# ===========================================
# Server configuration
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# Health check endpoint
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/api/health

# ===========================================
# PERFORMANCE SETTINGS
# ===========================================
# Memory limits
NODE_OPTIONS=--max-old-space-size=2048

# Cache settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ===========================================
# SECURITY SETTINGS
# ===========================================
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
CORS_ORIGIN=https://chat.sayers.app
CORS_CREDENTIALS=true

